<Window x:Class="Menfan.App.RecorderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Menfan Screen Recorder · 录制" FontFamily="Microsoft YaHei UI" FontSize="15" FontWeight="Normal" Width="980" Height="178" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen" Closing="OnClosing">
  <Window.Resources>
    <Style x:Key="ModeButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Width" Value="72"/><Setter Property="Height" Value="65"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" CornerRadius="14" Background="Transparent" Margin="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="Normal"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AudioToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="50"/><Setter Property="Height" Value="50"/><Setter Property="Margin" Value="4,0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" CornerRadius="25" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource ControlBrush}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="Normal"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Background="{DynamicResource WindowBrush}" CornerRadius="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="8" Padding="20,10" MouseLeftButtonDown="DragWindow">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition x:Name="ActionRow" Height="74"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="menfan" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/><TextBlock Text="SCREEN RECORDER" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="72,0,0,0" VerticalAlignment="Center"/>
        <StackPanel x:Name="HeaderLinks" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="设置" Click="Settings_Click" Padding="10,3" Background="Transparent" FontSize="15"/><Button Content="设备与保存" Click="Devices_Click" Padding="10,3" Background="Transparent" FontSize="15"/><Button Content="导入视频" Click="Import_Click" Padding="10,3" Background="Transparent" FontSize="15"/><Button Content="打开项目" Click="Open_Click" Padding="10,3" Background="Transparent" FontSize="15"/><Button Content="剪辑 ↗" x:Name="EditorButton" Click="Editor_Click" Padding="10,3" Background="Transparent" FontSize="15"/><Button Content="×" Click="Exit_Click" Padding="9,0" Background="Transparent" FontSize="21" Margin="8,0,0,0"/></StackPanel>
      </Grid>
      <Grid x:Name="Preparation" Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="296"/><ColumnDefinition Width="1"/><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="Modes" Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton x:Name="DisplayMode" Style="{StaticResource ModeButton}" GroupName="Source" IsChecked="True" Checked="Source_Changed" Tag="0"><StackPanel><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="显示器" FontSize="15" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></RadioButton>
          <RadioButton x:Name="WindowMode" Style="{StaticResource ModeButton}" GroupName="Source" Checked="Source_Changed" Tag="1"><StackPanel><TextBlock Text="&#xE737;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="窗口" FontSize="15" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></RadioButton>
          <RadioButton x:Name="RegionMode" Style="{StaticResource ModeButton}" GroupName="Source" Checked="Source_Changed" Tag="2"><StackPanel><TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="区域" FontSize="15" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></RadioButton>
          <RadioButton x:Name="DeviceMode" Style="{StaticResource ModeButton}" GroupName="Source" Checked="Source_Changed" Tag="3"><StackPanel><TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="设备" FontSize="15" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></RadioButton>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource ControlBrush}" Height="42"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
          <ToggleButton x:Name="Microphone" Style="{StaticResource AudioToggle}" ToolTip="麦克风 · 默认输入设备" Checked="Audio_Changed" Unchecked="Audio_Changed"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="22"/></ToggleButton>
          <ToggleButton x:Name="SystemSound" Style="{StaticResource AudioToggle}" ToolTip="系统声音 · 默认输出设备" IsChecked="True" Checked="Audio_Changed" Unchecked="Audio_Changed"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="22"/></ToggleButton>
          <Button Content="◇" ToolTip="添加录制标记 · Ctrl+Alt+M" x:Name="MarkButton" Click="Marker_Click" Width="34" Padding="0" Background="Transparent" Margin="0" FontSize="23"/>
        </StackPanel>
        <Grid Grid.Column="3" Margin="8,0,12,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="Sources" Margin="0" SelectionChanged="Target_Changed" ToolTip="选择显示器或窗口" MaxDropDownHeight="300"/>
          <ComboBox x:Name="Fps" Grid.Column="1" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="Audio_Changed"><ComboBoxItem Content="30 fps"/><ComboBoxItem Content="60 fps"/></ComboBox>
        </Grid>
        <Button Grid.Column="4" x:Name="StartStop" Content="●  开始录制" Background="{DynamicResource HoverBrush}" Foreground="{DynamicResource TextBrush}" Height="46" Margin="0" Padding="10,8" Click="Record_Click"/>
      </Grid>
      <StackPanel x:Name="RecordingBar" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
        <Button x:Name="PauseRecording" Content="Ⅱ 暂停" Click="Pause_Click" Padding="12,7"/>
        <Button Content="备忘录" Click="Notes_Click" Padding="12,7"/><Button Content="◇ 标记" Click="Marker_Click" Padding="12,7"/>
        <Button Content="桌面图标" Click="Desktop_Click" Padding="12,7"/><Button x:Name="RecordingStop" Content="■ 停止" Click="Record_Click" Padding="12,7" Background="{DynamicResource HoverBrush}"/>
      </StackPanel>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Hint" Text="准备就绪 · Ctrl+Alt+R 开始录制" FontSize="14" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/><CheckBox Grid.Column="1" x:Name="HidePanelsToggle" Content="录制时隐藏面板" ToolTip="倒计时结束后隐藏软件面板。Ctrl+Alt+R 或双击托盘图标停止录制。" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,8,0" Checked="HidePanels_Changed" Unchecked="HidePanels_Changed"/><TextBlock Grid.Column="2" x:Name="Clock" Text="00:00:00" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="15" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
    </Grid>
  </Border>
</Window>
