<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Menfan.ScreenRecorder</AssemblyName>
    <Product>Menfan Screen Recorder</Product>
    <Version>0.5.0-beta.2</Version>
    <ApplicationIcon>Assets/menfan-icon-v3.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/menfan-icon-v3.png" />
    <Resource Include="Assets/menfan-icon-v3.ico" />
    <ProjectReference Include="../Menfan.Core/Menfan.Core.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
